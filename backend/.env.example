# --- LLM provider selection -------------------------------------------------
# Which provider the conversation runner uses. "deepseek" (primary) or "anthropic" (fallback).
LLM_PROVIDER=deepseek

# --- DeepSeek (primary) -----------------------------------------------------
# DeepSeek is OpenAI-SDK compatible; the runner uses JSON mode for structured turns.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Thinking mode: "enabled" (default) = the agent reasons about the conversation
# (asks the tax year, follows up on vague answers, infers what to ask) — the product
# thesis, ~8-9s/turn. "disabled" = faster (~3s) but thinner/more mechanical.
DEEPSEEK_THINKING=enabled

# --- Anthropic (fallback) ---------------------------------------------------
# Claude Sonnet 5. The runner disables thinking on this path for chat latency.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- App --------------------------------------------------------------------
# Which firm's ruleset to load (directory name under rules/).
FIRM=steuerkanzlei_mueller
# CORS origin for the Next.js dev server.
FRONTEND_ORIGIN=http://localhost:3000
